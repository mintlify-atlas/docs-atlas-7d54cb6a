  "projectType": "cli-tool",
  "projectName": "Inscribe",
  "projectDescription": "Inscribe is the compiler toolchain for the Mentalogue Language (.mtl), providing lexing, parsing, type-checking, HIR/MIR lowering, native code generation, sandboxed execution, and a VS Code extension.",
